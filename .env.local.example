# ─── Resend API Key für E-Mail-Versand ───
# Registrierung: https://resend.com
RESEND_API_KEY=re_your_api_key_here

# ─── Öffentliche URL der App (für QR-Codes und E-Mail-Links) ───
# Lokal: http://localhost:3000
# Produktion: https://cards.mpool.de
NEXT_PUBLIC_BASE_URL=https://your-domain.de

# ─── Admin-Passwort ───
# Mindestens 12 Zeichen, Groß-/Kleinbuchstaben und Zahlen
# Wird nach erstem Login automatisch als salted Hash gespeichert
ADMIN_PASSWORD=ChangeThisToSomethingSecure123

# ─── Session-Secret (64 zufällige Hex-Zeichen) ───
# Generieren mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-hex-string

# ─── Persistenter Storage für Laufzeitdaten und Uploads ───
# Lokal reicht der Default-Ordner "storage"
# Auf dem VPS besser z.B. /var/lib/mpool-cards
STORAGE_DIR=storage

# ─── Google Wallet (Generic Pass) ───
# Issuer ID aus der Google Pay & Wallet Console
GOOGLE_WALLET_ISSUER_ID=
# Service-Account JSON als Base64, damit es sauber in Vercel Env Vars passt
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=
# Optionaler Class-Suffix, Standard z.B. business-card
GOOGLE_WALLET_CLASS_SUFFIX=business-card

# ─── Apple Wallet (pkpass) ───
# Team ID aus dem Apple Developer Account
APPLE_WALLET_TEAM_ID=
# Pass Type ID, muss mit "pass." anfangen
APPLE_WALLET_PASS_TYPE_IDENTIFIER=
# Anzeigename auf dem Pass, z.B. mpool consulting
APPLE_WALLET_ORGANIZATION_NAME=
# Exportiertes .p12 Zertifikat als Base64
APPLE_WALLET_CERTIFICATE_P12_BASE64=
# Passwort des exportierten .p12 Zertifikats
APPLE_WALLET_CERTIFICATE_PASSWORD=
# Nur nötig, falls die .p12 die Zertifikatskette NICHT enthält:
# Apple WWDR-Zwischenzertifikat (G4) als Base64-PEM
# Download: https://www.apple.com/certificateauthority/AppleWWDRCAG4.cer
APPLE_WALLET_WWDR_PEM_BASE64=
